{
  "id": "short-drama",
  "version": "0.2",
  "name": "AI short drama (30s)",
  "description": "One premise to a 30-second episode scaffold: script, cast, two shot prompts, planning stills, two prompt-only 15s videos, assembly notes. Agent selects intermediates. Media roles are not used for video.",
  "inputs": [
    { "key": "idea", "type": "text", "required": true, "label": "One-line drama idea" }
  ],
  "steps": [
    {
      "id": "script",
      "kind": "reason",
      "promptRef": "prompts/script.md",
      "inputs": [{ "from": "input:idea", "role": "idea" }],
      "output": { "type": "text" }
    },
    {
      "id": "cast",
      "kind": "reason",
      "promptRef": "prompts/extract-characters.md",
      "inputs": [{ "from": "step:script", "role": "script" }],
      "output": { "type": "text", "list": true }
    },
    {
      "id": "characters",
      "kind": "skill",
      "skillRef": "character-creation",
      "forEach": "step:cast",
      "inputs": [{ "from": "item", "role": "description" }]
    },
    {
      "id": "storyboard",
      "kind": "reason",
      "promptRef": "prompts/storyboard.md",
      "inputs": [
        { "from": "step:script", "role": "script" },
        { "from": "step:characters", "role": "characters" }
      ],
      "output": { "type": "text", "list": true }
    },
    {
      "id": "shotImage",
      "kind": "capability",
      "capability": "image.generate",
      "forEach": "step:storyboard",
      "promptRef": "prompts/shot-image.md",
      "inputs": [{ "from": "item", "role": "prompt" }],
      "values": {}
    },
    {
      "id": "shotVideo",
      "kind": "capability",
      "capability": "video.generate",
      "forEach": "step:storyboard",
      "promptRef": "prompts/shot-video.md",
      "inputs": [{ "from": "item", "role": "prompt" }],
      "values": { "duration": 15, "resolution": "720p", "aspect": "9:16" }
    }
  ],
  "output": { "type": "video", "from": "step:shotVideo", "list": true }
}
